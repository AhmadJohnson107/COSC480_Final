<!DOCTYPE html>
<html>
<head>
  <title>Super Earth Treasury Bank</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body class="terminal">

<body class="helldivers">
  <header class="banner">
    <h1>SUPER EARTH TREASURY BANK</h1>
    <p>Financing Managed Democracy.</p>
  </header>

  <section class="account">
    <h2>Helldiver Account</h2>
    <p>Rank: <%= account.rank %></p>
    <p>Requisition Credits: <%= account.balance %></p>

    <form action="/bank/deposit" method="POST">
      <input type="number" name="amount" placeholder="War Bond Amount" required>
      <button type="submit">Deposit War Bonds</button>
    </form>

    <form action="/bank/withdraw" method="POST">
      <input type="number" name="amount" placeholder="Withdraw Credits" required>
      <button type="submit">Withdraw Credits</button>
    </form>
  </section>

  <section class="transactions">
    <h2>Mission Expenditure Log</h2>
    <table>
      <tr><th>Type</th><th>Amount</th></tr>
      <% transactions.forEach(t => { %>
        <tr>
          <td><%= t.type %></td>
          <td><%= t.amount %></td>
        </tr>
      <% }) %>
    </table>
  </section>
</body>
</html>
